<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/ios_spring">
    <alpha
        android:duration="360"
        android:fromAlpha="0"
        android:interpolator="@android:anim/decelerate_interpolator"
        android:toAlpha="1" />
    <translate
        android:duration="560"
        android:fromYDelta="14%"
        android:toYDelta="0" />
    <scale
        android:duration="560"
        android:fromXScale="0.93"
        android:fromYScale="0.93"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1"
        android:toYScale="1" />
</set>
